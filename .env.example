# =================================================================
# Root Environment Configuration Template for Docker Compose
# Copy this file to '.env' and adjust values as needed.
# =================================================================

# PostgreSQL Database Credentials & Configuration
POSTGRES_DB=employeedb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass

# Backend Connection String (Database service host name in docker network is 'db')
DATABASE_URL=postgresql://postgres:postgres_secure_pass@db:5432/employeedb

# Application Environment & Storage Configuration
ENVIRONMENT=production
STORAGE_MODE=s3

# AWS / LocalStack Credentials & Endpoint Configurations
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key
S3_BUCKET_NAME=employee-photos-bucket
S3_ENDPOINT_URL=http://localstack:4566
SQS_QUEUE_URL=http://localstack:4566/000000000000/employee-photo-tasks

# Local Port Mappings (Optional overrides)
BACKEND_PORT=8000
FRONTEND_PORT=3000
DB_PORT=5432
LOCALSTACK_PORT=4566
LOCALSTACK_SERVICES=s3,sqs
