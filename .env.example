# =================================================================
# Application Environment Configuration
# =================================================================

ENVIRONMENT=production
STORAGE_MODE=s3


# =================================================================
# AWS RDS PostgreSQL Configuration
# =================================================================

# RDS database name
POSTGRES_DB=employeedb

# RDS database username
POSTGRES_USER=postgres

# RDS database password
POSTGRES_PASSWORD=YOUR_RDS_PASSWORD

# RDS endpoint
# Example:
# employee-db.abc123xyz.us-east-1.rds.amazonaws.com
RDS_HOST=YOUR_RDS_ENDPOINT.rds.amazonaws.com

# PostgreSQL port
RDS_PORT=5432

# Complete PostgreSQL connection string
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${RDS_HOST}:${RDS_PORT}/${POSTGRES_DB}


# =================================================================
# AWS Configuration
# =================================================================

AWS_REGION=us-east-1

# LocalStack credentials
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key


# =================================================================
# S3 Configuration
# =================================================================

S3_BUCKET_NAME=employee-photos-bucket

# LocalStack S3 endpoint
S3_ENDPOINT_URL=http://localstack:4566


# =================================================================
# SQS Configuration
# =================================================================

# LocalStack SQS queue
SQS_QUEUE_URL=http://localstack:4566/000000000000/employee-photo-tasks


# =================================================================
# Docker Port Configuration
# =================================================================

BACKEND_PORT=8000
FRONTEND_PORT=3000
LOCALSTACK_PORT=4566

# LocalStack services
LOCALSTACK_SERVICES=s3,sqs
